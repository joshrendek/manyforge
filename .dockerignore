# Build context excludes for the app Dockerfile. Keep go.mod/go.sum, migrations/,
# and web/ sources — the Dockerfile needs them.
.git
tmp/
.superpowers/
.pair/
*.png
docs/
specs/
.beads/

# Independently distributed SDKs, canonical contracts and release-only tooling
# are not dependencies of either Go application image or the Angular build.
api/
sdk/
tools/sdk/
release-please-config.json
.release-please-manifest.json
.github/workflows/sdk-*.yml
.github/workflows/ci.yml
.github/CODEOWNERS

web/node_modules
web/dist
web/.angular
landing/

# Placeholder committed so the ui_embed build tag has a non-empty //go:embed
# match before a real Angular build lands; the Dockerfile build stage
# regenerates this directory from the SPA build.
internal/webui/dist

# Secret-bearing files excluded from build context
.env
.env.*
.air.env
secrets/
*.pem
auth.json
